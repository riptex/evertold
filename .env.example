# Copy to .env.local and fill in real values. Never commit .env.local.
# EXPO_PUBLIC_ prefix is required for Expo to inline these into the
# client bundle — see https://docs.expo.dev/guides/environment-variables/

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=


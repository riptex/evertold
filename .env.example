# Copy to .env.local and fill in real values. Never commit .env.local.
# EXPO_PUBLIC_ prefix is required for Expo to inline these into the
# client bundle — see https://docs.expo.dev/guides/environment-variables/
#
# For real builds, set the same values as EAS secrets instead of relying
# on .env.local (which never leaves your machine):
#   eas secret:create --scope project --name EXPO_PUBLIC_SUPABASE_URL --value "..."
# CI (.github/workflows/ci.yml) only runs typecheck/lint/test — none of
# these are needed there yet. They'll matter once CI also runs EAS builds.

# Supabase — see docs/architecture/data-model.md (task 01) and
# supabase/migrations/ (task 03). Anon key only — never the service_role
# key, which belongs solely in Edge Function environments.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat — subscriptions + gifting (PLAN.md §5, §3.1). Public SDK
# keys are safe to embed client-side; there's a separate key per platform.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# PostHog — analytics (PLAN.md §5).
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Sentry — crash reporting (PLAN.md §5). The DSN is safe client-side;
# source-map upload during EAS builds needs a separate auth token set as
# an EAS secret (SENTRY_AUTH_TOKEN), not an EXPO_PUBLIC_ var.
EXPO_PUBLIC_SENTRY_DSN=

# Not yet wired into any app code — RevenueCat/PostHog/Sentry SDK
# integration are later tasks. Listed now so the EAS-secrets inventory
# and CI-vs-build-time split is settled before those tasks need it.
